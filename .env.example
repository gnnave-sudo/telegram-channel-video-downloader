# Telegram Channel Video Downloader - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Required: Get these from https://my.telegram.org/auth
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Required: Channel to download videos from (username like @channelname or ID like -100xxxx)
TELEGRAM_CHANNEL=@your_channel_username

# Optional: Telegram Bot for notifications (get token from @BotFather)
TELEGRAM_BOT_API_KEY=your_bot_token_here

# Optional: Chat ID to receive notifications (your user ID or group ID)
TELEGRAM_CHAT_ID=your_chat_id_here
